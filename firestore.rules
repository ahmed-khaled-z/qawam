rules_version = '2';
// Firebase Firestore Security Rules
// Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write only their own profile
    match /users_profile/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Feature requests (Suggest a Feature)
    // - Users can create and read only their own suggestions.
    // - Only admins can update (e.g. status). Set custom claim admin=true via Admin SDK.
    // - Users can delete their own suggestion (withdraw).
    match /feature_requests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'message', 'createdAt', 'status'])
        && request.resource.data.status == 'pending';
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && request.auth.token.admin == true;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Add other collection rules below (e.g. expenses, categories)
  }
}
